# Recommended starting Kconfig values for an aurora-harness project.
# Conservative defaults; tune per your board.

# Target — explicitly set so `idf.py build` on a fresh clone doesn't
# default to plain `esp32` (which wouldn't have PSRAM and would break
# the LVGL framebuffer allocation below). Change to esp32c6 / esp32p4
# etc. as appropriate AND rerun `idf.py set-target` before first build.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# LVGL typically needs PSRAM for full-screen buffers.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# console_protocol prefers USB-Serial-JTAG (no extra wires on most dev kits).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# v1 multi-agent scenes copy bounded agent_slot_t arrays on the stack
# during per-tick render and during init. With AGENT_SLOT_MAX=4 each
# tick needs ~5 KB of stack; the default 3584-byte main task is too
# small, so bump it. (LVGL task has its own stack and is sized via
# the LVGL adapter config.)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# aurora-harness ships a `?dump` screenshot command that uses
# lv_snapshot_take_to_draw_buf — that LVGL feature is OFF by default.
# Without this, `components/aurora-harness/src/screenshot.c` fails to
# compile with `implicit declaration of function 'lv_snapshot_take_to_draw_buf'`.
CONFIG_LV_USE_SNAPSHOT=y

# LVGL's libc-malloc adapters (we use them in Aurora; keeping the
# defaults here means PSRAM is the malloc backend automatically).
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# LVGL OS layer: aurora-harness assumes FreeRTOS-backed mutexes for
# inter-task safety. Default is "none" which breaks lv_async_call
# correctness in console-driven flows.
CONFIG_LV_OS_FREERTOS=y

# 16 MB flash with two OTA slots is the Aurora default. Adjust
# partitions.csv to match if your board has 4 MB / 8 MB flash.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Fonts used across the dashboard scenes (v2.3.0 typography scale-up).
#   12 — small captions / counters under big numbers
#   14 — eyebrow text + agent_chip mini-tag
#   16 — footer ("waiting Xs · +N more"), feed-row time column
#   20 — push banner detail line
#   22 — context lines under AWAITING headline + feed-row target column
#   28 — feed-row verb (Edit / Bash / ...), AWAITING agent chip
#   36 — AWAITING glyph (LV_SYMBOL_WARNING etc.)
#   48 — AWAITING headline ("your turn" / "approve?" / ...)
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# On-device CJK via lv_tiny_ttf (embedded SimHei subset)
CONFIG_LV_USE_TINY_TTF=y
# 6MB app partition (was default 1MB single-app) — needed for the embedded
# ~2MB CJK font subset. Uses the project's partitions.csv.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=256

# Task-WDT starvation (render wedge) must self-heal: panic -> reboot -> bridge
# force-resyncs within seconds. Better a 15s blip than a frozen panel.
CONFIG_ESP_TASK_WDT_PANIC=y

# ── Render throughput (v6.3) ─────────────────────────────────────────
# Measured on device with `?perf`: during scene transitions rendering
# costs 21-39 ms/frame (peak 77) while the QSPI flush wait is only
# 0.4-0.6 ms. The panel bus is NOT the bottleneck — software rasterising
# is, by ~40x. So the lever is the draw path, not the pixel clock.
#
# MEASURED DEAD END — do not retry without new evidence:
# CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2 (use the second core for drawing)
# made things WORSE and unstable. Render time per transition frame rose
# 21.7->30.8 ms (clock), 38.9->53.9 ms (weather), 21.5->29.5 ms
# (dashboard), fps fell ~15%, and the device rebooted mid-measurement.
# Reason: with a 28-row partial buffer each refresh is chopped into many
# small chunks, so the per-chunk draw tasks are tiny — cross-thread
# dispatch and the LVGL task's wait on both units cost more than the
# parallelism returns, and the extra 8 KB draw-thread stack squeezes an
# internal heap that only has ~56 KB steady-state headroom.
# The bottleneck is pixel volume, not core count: transitions dirty
# 300k-760k px/frame against a 217k-px screen.

# == MEASURED NON-ISSUES (v6.4) -- do not reopen without new evidence ==
# Two items sat on the tech-debt list on the theory that they cost RAM
# or flash. Both were measured; neither does.
#
#  * 'WiFi is compiled in but never used (the host link is USB-CDC and
#    transport_wifi.c is not in SRCS); turning it off frees internal RAM
#    for a bigger draw buffer.' It does not. Static DRAM is .data 14 KB +
#    .bss 13 KB TOTAL -- -ffunction-sections/-fdata-sections had already
#    dropped every unreferenced WiFi static. Flipping ESP_WIFI_ENABLED
#    changed the image by ZERO bytes (2939541 either way), and the symbol
#    is re-derived by the dependency graph, so an sdkconfig line does not
#    even stick.
#  * 'Eight LV_FONT_MONTSERRAT sizes enabled, four referenced, the rest
#    waste flash.' They do not: the unreferenced glyph tables are absent
#    from the .map entirely. Kconfig-enabled != linked.
#
# What DOES hold internal RAM: CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL (16384)
# sends every allocation <=16 KB to INTERNAL, and LVGL objects plus
# tiny_ttf cache blocks are all under that. Boot ~186 KB free -> ~32 KB
# steady, and FLAT across scene visits (measured: no leak). Lowering it
# would push LVGL objects into slower PSRAM and still would not help the
# draw buffer, which is allocated early while internal RAM is uncontended.
# 56 rows stays the practical ceiling: two 107 KB buffers need ~215 KB
# contiguous and only ~211 KB exists at that moment.
