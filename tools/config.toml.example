# ~/.claude-buddy/config.toml — sample
#
# Generated by claude_buddy_bridge on first run if missing.
# CLI flags override every key below. Keys mirror flag names with
# `--` stripped and `-` swapped for `_` (e.g. --throttle-ms → throttle_ms).
#
# Re-edit and SIGHUP the bridge (or restart it) to apply.

# Snapshot publisher
throttle_ms = 250            # min interval between snapshot pushes
keepalive_ms = 10000         # max interval between snapshot pushes
permission_timeout_s = 60    # how long to wait for a permission EVT

# Device identity (mirrored into `dash config` on connect)
device_name = "Clawd"
owner = "Felix"
theme = "noir"               # noir | lab | mono

# Transport
port_kind = "serial"         # serial | tcp
serial_port = "COM9"         # only used when port_kind = "serial"
tcp_port = "127.0.0.1:9876"  # only used when port_kind = "tcp"

# Local socket for hook_dispatch.py clients
listen = "127.0.0.1:7321"

# Health poll cadence (seconds)
health_poll_s = 5
